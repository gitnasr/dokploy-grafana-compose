// =============================================================================
// Receivers (ingest surfaces)
// =============================================================================

// Metrics: Prometheus remote_write  ->  Mimir
prometheus.receive_http "metrics_ingest" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 9090
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// Host metrics: scrape node_exporter  ->  Mimir
prometheus.scrape "node_exporter" {
  targets = [
    { __address__ = "node-exporter:9100", instance = "host" },
  ]
  forward_to      = [prometheus.remote_write.mimir.receiver]
  scrape_interval = "30s"
  job_name        = "node-exporter"
}

// Self-monitoring. Without this, the ingest pipeline is the one component in
// the stack with no telemetry of its own — a dropped-spans or refused-samples
// problem would be invisible precisely when you need to see it.
prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy_self" {
  targets         = prometheus.exporter.self.alloy.targets
  forward_to      = [prometheus.remote_write.mimir.receiver]
  scrape_interval = "30s"
  job_name        = "alloy"
}

// Logs: Loki push API  ->  Loki
loki.source.api "logs_ingest" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 3500
  }
  forward_to = [loki.write.default.receiver]
}

// Traces / metrics / logs via OpenTelemetry (OTLP HTTP + gRPC)
otelcol.receiver.otlp "ingest" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  output {
    traces  = [otelcol.processor.memory_limiter.default.input]
    metrics = [otelcol.processor.memory_limiter.default.input]
    logs    = [otelcol.processor.memory_limiter.default.input]
  }
}

// Browser RUM: Grafana Faro Web SDK -> Loki (logs, events, exceptions, web
// vitals) and Tempo (browser spans). Browser spans carry the same trace ID the
// SDK propagates to the backend via `traceparent`, so a page interaction and
// the API request it triggered land in one trace.
//
// Unlike the OTLP and remote_write ports, this one is called directly by
// end-user browsers, so it cannot sit behind basic auth — CORS is the gate.
faro.receiver "frontend" {
  // Without extra_log_labels the receiver emits entries carrying no Loki
  // labels at all, so nothing forms a queryable stream — the data reaches
  // Alloy and then effectively disappears. `kind` is filled from each
  // payload (log / event / exception / measurement), which is what the
  // frontend dashboard filters on.
  extra_log_labels = {
    app  = "igpd-fe-browser",
    kind = "",
  }

  server {
    listen_address           = "0.0.0.0"
    listen_port              = 12347
    // The FRONTEND origin, which is ig-fe.secretzone.top. ig.secretzone.top is
    // the C# API — putting that here instead silently blocks every beacon at
    // the CORS preflight, and the only symptom is a browser console error the
    // backend never sees.
    cors_allowed_origins     = ["https://ig-fe.secretzone.top", "http://localhost:3000"]
    max_allowed_payload_size = "10MiB"
  }

  sourcemaps {
    download = false
  }

  output {
    logs   = [loki.write.default.receiver]
    traces = [otelcol.processor.memory_limiter.default.input]
  }
}

// =============================================================================
// Processors
// =============================================================================

// Hard ceiling ahead of batching. The container is memory-capped and an ingest
// spike would otherwise OOM Alloy and take down all three signals at once.
//
// Sized generously relative to the container limit on purpose. This was
// originally 384MiB against a 512MiB container, and under real scraper load it
// shed ~9.9M spans, ~1.5M metric points and ~200k log records — the metric
// series went visibly gappy for hours while the app itself was healthy. A
// limiter that trips constantly is worse than none: it silently deletes the
// data you deployed it to collect.
otelcol.processor.memory_limiter "default" {
  check_interval = "1s"
  limit          = "1500MiB"
  spike_limit    = "256MiB"

  output {
    traces  = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
  }
}

// The receiver used to wire straight to the exporters, so every OTLP push
// became an immediate downstream write. Batching amortises that.
otelcol.processor.batch "default" {
  timeout             = "5s"
  send_batch_size     = 8192
  send_batch_max_size = 16384

  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.to_mimir.input]
    logs    = [otelcol.exporter.otlphttp.to_loki.input]
  }
}

// =============================================================================
// Exporters (internal fan-out to backends)
// =============================================================================

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"

    // Exemplars are what turn a latency panel into a click-through to the slow
    // trace behind the spike. Mimir accepts them; remote_write drops them by
    // default.
    send_exemplars = true
  }
  external_labels = {
    cluster   = "production",
    namespace = "monitoring",
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

// OTLP metrics -> Prometheus remote_write -> Mimir
otelcol.exporter.prometheus "to_mimir" {
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// OTLP logs -> Loki's NATIVE OTLP endpoint.
//
// This used to be `otelcol.exporter.loki`, forwarding into loki.write. The
// comment above it claimed attributes were carried as structured metadata. They
// were not: that component serialises the WHOLE OTel record into the log line as
// JSON, so a 70-character message arrived in Loki as an ~850-byte envelope —
//
//   {"body":"FinalizeAttempt JobId=…: finalized as COMPLETED.",
//    "traceid":"…","spanid":"…","severity":"Information",
//    "attributes":{"JobId":"…","Step":"finalize","Username":"…",
//                  "TraceId":"…","SpanId":"…","{OriginalFormat}":"…"},
//    "resources":{"service.name":"igpd-worker","service.version":"1.0.0", …},
//    "instrumentation_scope":{"name":"…"}}
//
// ~90% of every line was the resources block (identical on every line, and
// already available as labels) plus TraceId/SpanId duplicated at both levels.
// Three consequences, all observed: the Grafana logs panel rendered a wall of
// JSON instead of messages; free-text search matched resource attribute values,
// so searching "worker" hit every line ever written; and JobId/Username/Step
// were unfilterable without a `| json` stage because no structured metadata
// existed at all.
//
// Loki's OTLP receiver does the mapping the old comment described: body becomes
// the log line, resource attributes become labels, and remaining log attributes
// become structured metadata. The receiving side was already configured for it —
// monitoring/loki/loki.yml runs Loki 3.4.2 on schema v13/tsdb with
// allow_structured_metadata: true.
//
// The endpoint is the /otlp BASE. otlphttp appends the /v1/logs signal path
// itself; writing the full path here yields /otlp/v1/logs/v1/logs and a silent 404.
otelcol.exporter.otlphttp "to_loki" {
  client {
    endpoint = "http://loki:3100/otlp"
  }
}
