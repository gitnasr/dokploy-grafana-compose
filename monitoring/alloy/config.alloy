// =============================================================================
// Receivers (ingest surfaces)
// =============================================================================

// Metrics: Prometheus remote_write  ->  Mimir
prometheus.receive_http "metrics_ingest" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 9090
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// Host metrics: scrape node_exporter  ->  Mimir
prometheus.scrape "node_exporter" {
  targets = [
    { __address__ = "node-exporter:9100", instance = "host" },
  ]
  forward_to      = [prometheus.remote_write.mimir.receiver]
  scrape_interval = "30s"
  job_name        = "node-exporter"
}

// Self-monitoring. Without this, the ingest pipeline is the one component in
// the stack with no telemetry of its own — a dropped-spans or refused-samples
// problem would be invisible precisely when you need to see it.
prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy_self" {
  targets         = prometheus.exporter.self.alloy.targets
  forward_to      = [prometheus.remote_write.mimir.receiver]
  scrape_interval = "30s"
  job_name        = "alloy"
}

// Logs: Loki push API  ->  Loki
loki.source.api "logs_ingest" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 3500
  }
  forward_to = [loki.write.default.receiver]
}

// Traces / metrics / logs via OpenTelemetry (OTLP HTTP + gRPC)
otelcol.receiver.otlp "ingest" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  output {
    traces  = [otelcol.processor.memory_limiter.default.input]
    metrics = [otelcol.processor.memory_limiter.default.input]
    logs    = [otelcol.processor.memory_limiter.default.input]
  }
}

// Browser RUM: Grafana Faro Web SDK -> Loki (logs, events, exceptions, web
// vitals) and Tempo (browser spans). Browser spans carry the same trace ID the
// SDK propagates to the backend via `traceparent`, so a page interaction and
// the API request it triggered land in one trace.
//
// Unlike the OTLP and remote_write ports, this one is called directly by
// end-user browsers, so it cannot sit behind basic auth — CORS is the gate.
faro.receiver "frontend" {
  server {
    listen_address           = "0.0.0.0"
    listen_port              = 12347
    // The FRONTEND origin, which is ig-fe.secretzone.top. ig.secretzone.top is
    // the C# API — putting that here instead silently blocks every beacon at
    // the CORS preflight, and the only symptom is a browser console error the
    // backend never sees.
    cors_allowed_origins     = ["https://ig-fe.secretzone.top", "http://localhost:3000"]
    max_allowed_payload_size = "10MiB"
  }

  sourcemaps {
    download = false
  }

  output {
    logs   = [loki.write.default.receiver]
    traces = [otelcol.processor.memory_limiter.default.input]
  }
}

// =============================================================================
// Processors
// =============================================================================

// Hard ceiling ahead of batching. The container is memory-capped and an ingest
// spike (a retry storm, a scrape burst) would otherwise OOM Alloy and take down
// all three signals at once. Refusing data beats dying.
otelcol.processor.memory_limiter "default" {
  check_interval = "1s"
  limit          = "384MiB"
  spike_limit    = "96MiB"

  output {
    traces  = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
  }
}

// The receiver used to wire straight to the exporters, so every OTLP push
// became an immediate downstream write. Batching amortises that.
otelcol.processor.batch "default" {
  timeout             = "5s"
  send_batch_size     = 8192
  send_batch_max_size = 16384

  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.to_mimir.input]
    logs    = [otelcol.exporter.loki.to_loki.input]
  }
}

// =============================================================================
// Exporters (internal fan-out to backends)
// =============================================================================

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"

    // Exemplars are what turn a latency panel into a click-through to the slow
    // trace behind the spike. Mimir accepts them; remote_write drops them by
    // default.
    send_exemplars = true
  }
  external_labels = {
    cluster   = "production",
    namespace = "monitoring",
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

// OTLP metrics -> Prometheus remote_write -> Mimir
otelcol.exporter.prometheus "to_mimir" {
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// OTLP logs -> Loki. Emits the labels {exporter, job, level, service_name};
// every other log attribute (JobId, Username, Step, trace_id, ...) is carried
// as Loki structured metadata, which is queryable without exploding cardinality.
otelcol.exporter.loki "to_loki" {
  forward_to = [loki.write.default.receiver]
}
