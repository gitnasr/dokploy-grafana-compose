    {
      "id": 40,
      "type": "heatmap",
      "title": "Job duration distribution",
      "description": "Where job durations actually cluster. A p95 line hides bimodal behaviour; this does not.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum by (le) (increase(igpd_job_duration_ms_bucket[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "instant": false,
          "range": true,
          "refId": "A",
