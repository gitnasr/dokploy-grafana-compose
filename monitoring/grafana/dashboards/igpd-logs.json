    {
      "id": 81,
      "type": "logs",
      "title": "Errors and warnings",
      "description": "Expand a line to see its structured metadata — JobId, Username, Step, and trace_id, which links straight through to the trace in Tempo.",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "editorMode": "code",
          "expr": "{service_name=~\"$svc\"} | detected_level =~ \"(?i)error|(?i)warn\" |~ \"$search\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 82,
      "type": "logs",
      "title": "All logs",
      "datasource": {
