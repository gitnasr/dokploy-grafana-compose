    {
      "id": 4,
      "type": "stat",
      "title": "API 5xx rate",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"igpd-api\",http_response_status_code=~\"5..\"}[$rate])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=\"igpd-api\"}[$rate])), 0.001)",
          "legendFormat": "5xx",
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 0
      },
