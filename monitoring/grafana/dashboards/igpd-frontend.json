        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.75, {app=\"igpd-fe-browser\"} | json | kind = `measurement` | value_lcp != `` | unwrap value_lcp [$__auto]) by (app)",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
