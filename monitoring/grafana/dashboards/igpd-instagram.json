{
  "uid": "igpd-instagram",
  "title": "IGPD — Instagram client",
  "description": "Instagram client internals: request rate and latency, retry and rate-limit signals, bootstrap token extraction, and the profile/posts pipeline.",
  "tags": [
    "igpd",
    "instagram"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "IGPD dashboards",
      "type": "dashboards",
      "tags": [
        "igpd"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "rate",
        "label": "Rate window",
        "type": "custom",
        "query": "1m,5m,15m,30m,1h",
        "current": {
          "text": "5m",
          "value": "5m"
        },
        "options": [
          {
            "text": "1m",
            "value": "1m",
            "selected": false
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": true
          },
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          },
          {
            "text": "30m",
            "value": "30m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 45,
      "type": "row",
      "title": "Requests",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 46,
      "type": "piechart",
      "title": "IG request outcomes",
      "description": "ok versus each failure mode, as a share of all requests in range.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (increase(igpd_ig_request_total[$__range]))",
          "legendFormat": "{{outcome}}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 47,
      "type": "timeseries",
      "title": "IG request rate by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum by (request_kind) (rate(igpd_ig_request_total[$rate]))",
          "legendFormat": "{{request_kind}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
