          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(igpd_ig_request_duration_ms_bucket[$rate])))",
          "legendFormat": "p50",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
