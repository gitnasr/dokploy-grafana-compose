          "legendFormat": "p95",
          "instant": false,
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(igpd_ig_request_duration_ms_bucket[$rate])))",
          "legendFormat": "p99",
          "instant": false,
