    {
      "id": 62,
      "type": "timeseries",
      "title": "Primary fetch rejected vs relay fallback",
      "description": "IG_GRAPHQL_ERROR is a handled condition, not an incident: IG refuses the primary profile query and the client recovers on the relay shape. Alarming only if rejections rise without matching recoveries.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum(rate(igpd_error_total{code=\"IG_GRAPHQL_ERROR\"}[$rate]))",
          "legendFormat": "rejected (IG_GRAPHQL_ERROR)",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum(rate(igpd_profile_fetch_path_total{path=\"relay_fallback\"}[$rate]))",
          "legendFormat": "recovered via relay",
          "instant": false,
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
