{
  "uid": "igpd-pipeline",
  "title": "IGPD — Pipeline health",
  "description": "Success rate, failures and latency for every instrumented component, path and pipeline, under one taxonomy. The per-component row repeats over whatever is reporting, so a newly instrumented component appears here automatically.",
  "tags": [
    "igpd",
    "pipeline",
    "ops"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "IGPD dashboards",
      "type": "dashboards",
      "tags": [
        "igpd"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "rate",
        "label": "Rate window",
        "type": "custom",
        "query": "5m,15m,1h,6h,24h",
        "current": {
          "text": "1h",
          "value": "1h"
        },
        "options": [
          {
            "text": "5m",
            "value": "5m",
            "selected": false
          },
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": true
          },
          {
            "text": "6h",
            "value": "6h",
            "selected": false
          },
          {
            "text": "24h",
            "value": "24h",
            "selected": false
          }
        ]
      },
      {
        "name": "component",
        "label": "Component",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(igpd_op_total, component)",
          "refId": "component"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 133,
      "type": "stat",
      "title": "Operations / min",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum(rate(igpd_op_total[$rate])) * 60",
          "legendFormat": "ops/min",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 134,
      "type": "stat",
      "title": "Overall success rate",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum(rate(igpd_op_total{outcome!=\"error\"}[$rate])) / clamp_min(sum(rate(igpd_op_total[$rate])), 0.0001)",
          "legendFormat": "success",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 135,
      "type": "stat",
      "title": "Components reporting",
      "description": "A drop here means a component stopped emitting entirely — which is the failure the old per-component counters could not show, because an absent series looks identical to a healthy quiet one.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "count(count by (component) (igpd_op_total))",
          "legendFormat": "components",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 136,
      "type": "timeseries",
      "title": "Throughput by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(igpd_op_total[$rate]))",
          "legendFormat": "{{outcome}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "skipped"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "empty"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 137,
      "type": "table",
      "title": "Worst operations by error rate",
      "description": "Ranked over the whole window. This is the panel to open first: it names the component, the operation and the classified reason together, so triage does not start with a metric name lookup. Empty is the good state — it means nothing recorded outcome=error.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "topk(15, sum by (component, operation, reason) (rate(igpd_op_total{outcome=\"error\"}[$__range])))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "refId": "A",
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {},
          "noValue": "No failed operations in this window"
        },
        "overrides": []
      }
    },
    {
      "id": 138,
      "type": "row",
      "title": "$component",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": [],
      "repeat": "component"
    },
    {
      "id": 139,
      "type": "timeseries",
      "title": "$component — success rate by operation",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum by (operation) (rate(igpd_op_total{component=~\"$component\",outcome!=\"error\"}[$rate])) / clamp_min(sum by (operation) (rate(igpd_op_total{component=~\"$component\"}[$rate])), 0.0001)",
          "legendFormat": "{{operation}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 13
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 140,
      "type": "timeseries",
      "title": "$component — failures by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (operation, reason) (rate(igpd_op_total{component=~\"$component\",outcome=\"error\"}[$rate])))",
          "legendFormat": "{{operation}} · {{reason}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 141,
      "type": "timeseries",
      "title": "$component — p95 latency by operation",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(igpd_op_duration_ms_bucket{component=~\"$component\"}[$rate])))",
          "legendFormat": "{{operation}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 13
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": false
          }
        },
        "overrides": []
      }
    }
  ]
}
