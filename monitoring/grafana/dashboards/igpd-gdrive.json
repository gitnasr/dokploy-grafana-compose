{
  "uid": "igpd-gdrive",
  "title": "IGPD — Google Drive",
  "description": "Drive uploader: uploads versus skips, API calls and failures by operation, upload latency, rate-limit pauses and folder-cache effectiveness.",
  "tags": [
    "igpd",
    "gdrive"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "IGPD dashboards",
      "type": "dashboards",
      "tags": [
        "igpd"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "rate",
        "label": "Rate window",
        "type": "custom",
        "query": "1m,5m,15m,30m,1h",
        "current": {
          "text": "5m",
          "value": "5m"
        },
        "options": [
          {
            "text": "1m",
            "value": "1m",
            "selected": false
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": true
          },
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          },
          {
            "text": "30m",
            "value": "30m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 54,
      "type": "stat",
      "title": "Upload rate",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum(rate(igpd_gdrive_uploaded_total[$rate])) * 60",
          "legendFormat": "uploads/min",
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 55,
      "type": "stat",
      "title": "API failure ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum(rate(igpd_gdrive_api_failure_total[$rate])) / clamp_min(sum(rate(igpd_gdrive_api_call_total[$rate])), 0.001)",
          "legendFormat": "fail",
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 56,
      "type": "stat",
      "title": "Folder-cache hit ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum(rate(igpd_gdrive_cache_hit_total[$rate])) / clamp_min(sum(rate(igpd_gdrive_cache_hit_total[$rate])) + sum(rate(igpd_gdrive_cache_miss_total[$rate])), 0.001)",
          "legendFormat": "hit",
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "options": {
        "colorMode": "value",
