      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum by (target) (rate(igpd_gdrive_uploaded_total[$rate]))",
          "legendFormat": "uploaded {{target}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum by (target) (rate(igpd_gdrive_skipped_total[$rate]))",
          "legendFormat": "skipped {{target}}",
          "range": true,
          "refId": "B"
        }
