          "editorMode": "code",
          "expr": "min(node_filesystem_avail_bytes{mountpoint=\"/rootfs\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/rootfs\",fstype!=\"tmpfs\"})",
